{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "maximized": true,
        "resizable": true,
        "title": "Yaanai"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$TEMP/**",
          "/Users/**",
          "/Volumes/**",
          "/tmp/**",
          "/private/tmp/**",
          "/private/var/folders/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "YAANAI - Desktop File Analyzer",
    "longDescription": "A modern desktop application for analyzing file systems, reviewing cleanup candidates, and managing disk space.",
    "externalBin": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "frameworks": []
    }
  },
  "productName": "yaanai",
  "identifier": "com.yaanai.filemanager",
  "version": "0.0.0"
}
